# Прямой запуск тренажёра (используется, если MOODLE_COURSE_URL пуст).
TARGET_URL=https://learngitbranching.js.org/?locale=ru_RU&NODEMO

# Запуск через учебный курс Moodle. Логин и пароль заполняются только локально.
MOODLE_COURSE_URL=https://e.moevm.info/course/view.php?id=88
MOODLE_USERNAME=
MOODLE_PASSWORD=
MOODLE_ACTIVITY_NAME=LearnGitBranching
MOODLE_ACTIVITY_URL=

# Настройки Selenium Grid.
SELENIUM_REMOTE_URL=http://selenium-hub:4444/wd/hub
SELENIUM_COMMAND_TIMEOUT=40
